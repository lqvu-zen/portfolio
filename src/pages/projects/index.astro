---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LevelCard from '../../components/LevelCard.astro';
import Sprite from '../../components/Sprite.astro';
import { lock } from '../../data/sprites';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Level select" description="Projects by Lê Quang Vũ: shipped games, engine work, tools and experiments.">
  <section class="wrap section">
    <p class="eyebrow">World map</p>
    <h1 class="page-title">Level select</h1>
    <p class="intro">
      Shipped games, engine work and the side projects that got me here. Pick a level to see what I built and how.
    </p>

    <div class="level-grid">
      {projects.map((p) => <LevelCard project={p} />)}
      <div class="locked px-box">
        <Sprite sprite={lock} scale={6} />
        <p class="display">Level ?-?</p>
        <p class="locked-note">More levels unlock soon.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-title { font-size: clamp(22px, 4.2vw, 36px); margin: 8px 0 18px; text-shadow: 4px 4px 0 var(--shadow); }
  .intro { max-width: 52ch; color: var(--ink-dim); margin-bottom: 48px; }
  .level-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 28px;
  }
  .locked {
    --c: var(--panel-2);
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    min-height: 320px;
    padding: 24px;
    background: repeating-linear-gradient(135deg, var(--bg-2) 0 12px, var(--panel) 12px 24px);
    text-align: center;
  }
  .locked .display { font-size: var(--fs-pixel-sm); margin: 0; color: var(--ink-dim); }
  .locked-note { margin: 0; color: var(--ink-dim); font-size: var(--fs-small); }
</style>
