---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import Sprite from '../../components/Sprite.astro';
import { star, check } from '../../data/sprites';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[i - 1], next: all[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
// Only show "Dev notes" when the Markdown body has more than the template comment.
const hasNotes = (project.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
const meta = [p.context, p.period, p.team].filter(Boolean);
---

<Base title={p.title} description={p.summary}>
  <article class="wrap section" style={`--accent: var(--${p.accent})`}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/projects/">◀ Level select</a>
    </nav>

    <header class="head">
      <p class="badge">Level {p.level} · {p.world}</p>
      <h1>{p.title}</h1>
      <p class="summary">{p.summary}</p>
      <ul class="meta">{meta.map((m) => <li>{m}</li>)}</ul>
    </header>

    {p.youtube && (
      <div class="media">
        <YouTube id={p.youtube} title={p.title} />
      </div>
    )}

    <div class="grid">
      <section class="quest px-box">
        <h2><Sprite sprite={star} scale={3} /> Quest log</h2>
        <ul class="quests">
          {p.role.map((r) => (
            <li>
              <span class="check"><Sprite sprite={check} scale={2} /></span>
              <span>{r}</span>
            </li>
          ))}
        </ul>
      </section>

      <aside class="side">
        <section class="px-box panel">
          <h2>Loadout</h2>
          <ul class="chips">{p.tech.map((t) => <li class="chip">{t}</li>)}</ul>
        </section>
        {p.links.length > 0 && (
          <section class="px-box panel">
            <h2>Warp pipes</h2>
            <ul class="links">
              {p.links.map((l) => (
                <li>
                  <a href={l.href} rel="noopener"><span class="tri" aria-hidden="true">▶</span> {l.label}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>

    {hasNotes && (
      <section class="notes">
        <h2>Dev notes</h2>
        <div class="prose"><Content /></div>
      </section>
    )}

    <nav class="pager" aria-label="More levels">
      {prev ? (
        <a class="px-btn ghost" href={`/projects/${prev.id}/`}>◀ {prev.data.level} {prev.data.title}</a>
      ) : <span />}
      {next ? (
        <a class="px-btn" href={`/projects/${next.id}/`}>{next.data.level} {next.data.title} ▶</a>
      ) : (
        <a class="px-btn" href="/projects/">Level select ▶</a>
      )}
    </nav>
  </article>
</Base>

<style>
  .crumbs { margin-bottom: 28px; }
  .crumbs a { font-family: var(--font-display); font-size: 10px; text-transform: uppercase; }

  .badge {
    display: inline-block;
    margin-bottom: 18px;
    padding: 7px 8px 6px;
    font-family: var(--font-display);
    font-size: 10px;
    text-transform: uppercase;
    background: var(--accent);
    color: var(--shadow);
  }
  h1 { font-size: clamp(20px, 4vw, 36px); margin-bottom: 18px; text-shadow: 4px 4px 0 var(--shadow); }
  .summary { font-size: 21px; max-width: 52ch; color: var(--ink); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 22px; list-style: none; padding: 0; margin: 0; color: var(--ink-dim); }
  .meta li { font-family: var(--font-display); font-size: 9px; text-transform: uppercase; }
  .meta li + li::before { content: '◆'; color: var(--accent); margin-right: 22px; margin-left: -12px; }

  .media { margin-top: 40px; max-width: 860px; }
  .media :global(.yt) { --c: var(--accent); }

  .grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 32px; margin-top: 48px; align-items: start; }
  .quest { padding: 28px; }
  .quest h2, .panel h2 { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--accent); }
  .quests { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .quests li { display: grid; grid-template-columns: 28px 1fr; gap: 10px; }
  .check {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 3px;
    background: var(--accent);
    color: var(--shadow);
  }
  .side { display: grid; gap: 28px; }
  .panel { padding: 24px; }
  .tri { font-size: 11px; }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }

  .notes { margin-top: 56px; max-width: 72ch; }
  .notes h2 { color: var(--accent); }
  .prose :global(h2), .prose :global(h3) { margin-top: 1.8em; color: var(--ink); }
  .prose :global(img) { border: 4px solid var(--panel-2); }
  .prose :global(code) { font-family: ui-monospace, monospace; background: var(--panel-2); padding: 1px 6px; }
  .prose :global(pre) { padding: 18px; overflow-x: auto; background: var(--shadow) !important; border: 4px solid var(--panel-2); }

  .pager {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 4px dashed var(--panel-2);
  }
  .pager .px-btn { max-width: 100%; line-height: 1.6; }

  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .quest { padding: 22px 18px; }
  }
</style>
