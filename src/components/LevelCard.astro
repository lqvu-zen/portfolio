---
import type { CollectionEntry } from 'astro:content';
import Sprite from './Sprite.astro';
import { star } from '../data/sprites';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const p = project.data;
---

<a class="level-card px-box" href={`/projects/${project.id}/`} style={`--accent: var(--${p.accent})`}>
  <div class="thumb">
    {p.youtube ? (
      <img
        src={`https://i.ytimg.com/vi/${p.youtube}/mqdefault.jpg`}
        alt=""
        width="320"
        height="180"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="no-footage">
        <Sprite sprite={star} scale={6} />
        <span>No footage</span>
      </div>
    )}
    <span class="badge">Level {p.level}</span>
  </div>
  <div class="body">
    <p class="world">{p.world}</p>
    <h3>{p.title}</h3>
    <p class="summary">{p.summary}</p>
    <ul class="chips">
      {p.tech.slice(0, 4).map((t) => <li class="chip">{t}</li>)}
    </ul>
    <span class="enter">▶ Enter level</span>
  </div>
</a>

<style>
  .level-card {
    --c: var(--panel-2);
    display: flex;
    flex-direction: column;
    color: var(--ink);
    text-decoration: none;
    transition: transform 80ms steps(2);
  }
  .level-card:hover,
  .level-card:focus-visible {
    --c: var(--accent);
    background: var(--panel);
    color: var(--ink);
    transform: translate(-4px, -4px);
  }
  .level-card:focus-visible { outline-offset: 10px; }

  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-2);
    border-bottom: 4px solid var(--accent);
    overflow: hidden;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.1) contrast(1.05); }
  .thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.22) 0 2px, transparent 2px 4px);
  }
  .no-footage {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 12px;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--fs-pixel-xs);
    text-transform: uppercase;
  }
  .badge {
    position: absolute;
    left: 8px;
    top: 8px;
    z-index: 1;
    padding: 6px 7px 5px;
    font-family: var(--font-display);
    font-size: var(--fs-pixel-xs);
    text-transform: uppercase;
    background: var(--accent);
    color: var(--shadow);
  }

  .body { display: flex; flex-direction: column; flex: 1; padding: 18px 18px 20px; }
  .world {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: var(--fs-pixel-xs);
    text-transform: uppercase;
    color: var(--accent);
  }
  h3 { margin-bottom: 10px; line-height: 1.6; }
  .summary { color: var(--ink-dim); font-size: var(--fs-small); line-height: 1.5; }
  .chips { margin-top: auto; padding-top: 4px; }
  .enter {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: var(--fs-pixel-xs);
    text-transform: uppercase;
    color: var(--accent);
  }
  .level-card:hover .enter { animation: nudge 0.4s steps(2) infinite; }
  @keyframes nudge { 50% { transform: translateX(4px); } }
</style>
