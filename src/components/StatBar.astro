---
interface Props {
  name: string;
  value: number; // 0–100
  color?: string;
}
const { name, value, color = 'gold' } = Astro.props;
const filled = Math.round(value / 10);
---

<div class="stat" style={`--fill: var(--${color})`}>
  <span class="name">{name}</span>
  <span class="bar" role="meter" aria-label={name} aria-valuemin="0" aria-valuemax="100" aria-valuenow={value}>
    {Array.from({ length: 10 }, (_, i) => <i class={i < filled ? 'on' : undefined} />)}
  </span>
  <span class="val" aria-hidden="true">{value}</span>
</div>

<style>
  .stat {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 32px;
    align-items: center;
    gap: 12px;
    padding-block: 6px;
  }
  .name { font-size: 17px; line-height: 1.3; }
  .bar { display: flex; gap: 3px; padding: 3px; background: var(--shadow); }
  .bar i { width: 10px; height: 14px; background: #2f2a63; }
  .bar i.on { background: var(--fill); box-shadow: inset 0 -3px 0 0 rgb(0 0 0 / 0.25); }
  .val { font-family: var(--font-display); font-size: 10px; text-align: right; color: var(--ink-dim); }
  @media (max-width: 420px) {
    .bar i { width: 7px; }
  }
</style>
