---
import Sprite from './Sprite.astro';
import { heart } from '../data/sprites';

const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: 'Levels', match: '/projects' },
  { href: '/about/', label: 'Character', match: '/about' },
  { href: '/resume.pdf', label: 'Resume', match: '/resume.pdf' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Lê Quang Vũ — home">
      <Sprite sprite={heart} scale={3} />
      <span>LQV</span>
    </a>
    <nav aria-label="Site">
      <ul>
        {links.map((l) => {
          const active = path.startsWith(l.match);
          return (
            <li>
              <a href={l.href} aria-current={active ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 4px solid var(--shadow);
    box-shadow: 0 4px 0 0 var(--panel-2);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
    padding: 6px;
  }
  .logo:hover { background: none; color: var(--gold); }
  ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block;
    padding: 10px 10px 9px;
    font-family: var(--font-display);
    font-size: 10px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-dim);
  }
  nav a:hover { color: var(--shadow); background: var(--gold); }
  nav a[aria-current='page'] { color: var(--gold); }
  nav a[aria-current='page']::before { content: '▶ '; }
  @media (max-width: 480px) {
    .logo span { display: none; }
    nav a { padding-inline: 7px; font-size: 9px; }
    nav a[aria-current='page']::before { content: ''; }
  }
</style>
