---
// Click-to-play YouTube embed: shows only the thumbnail until the visitor
// presses play, so the page doesn't load YouTube's player up front.
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div class="yt px-box" data-yt={id} data-title={title}>
  <button type="button" aria-label={`Play video: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="play">▶ Play</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    const btn = el.querySelector('button');
    btn?.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
        iframe.title = el.dataset.title ?? 'Video';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        el.replaceChildren(iframe);
        iframe.focus();
      },
      { once: true },
    );
  });
</script>

<style>
  .yt { --c: var(--line); aspect-ratio: 16 / 9; overflow: hidden; background: var(--shadow); }
  .yt button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .yt img { width: 100%; height: 100%; object-fit: cover; }
  .yt button::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.25) 0 2px, transparent 2px 4px);
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    transform: translate(-50%, -50%);
    padding: 16px 20px 15px;
    font-family: var(--font-display);
    font-size: 13px;
    text-transform: uppercase;
    background: var(--gold);
    color: var(--shadow);
    box-shadow: 0 0 0 4px var(--shadow), 8px 8px 0 4px rgb(0 0 0 / 0.5);
  }
  .yt button:hover .play,
  .yt button:focus-visible .play { background: var(--ink); }
  .yt :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
</style>
