---
import { profile } from '../data/profile';

const links = [
  { label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
  { label: 'GitHub', value: 'github.com/lqvu-zen', href: profile.github },
  { label: 'LinkedIn', value: 'www.linkedin.com/in/lqvu', href: profile.linkedin },
  { label: 'Resume', value: 'Download PDF', href: profile.resume },
];
const year = new Date().getFullYear();
---

<footer class="save-point" id="save-point">
  <div class="wrap">
    <div class="sp-grid">
      <div>
        <p class="eyebrow">Save point</p>
        <h2>Let's build something</h2>
        <p class="lead">
          Open to technical discussions, collaborations and new opportunities in game engine development.
        </p>
      </div>
      <ul class="sp-links">
        {links.map((l) => (
          <li>
            <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
              <span class="k">{l.label}</span>
              <span class="v">{l.value}</span>
              <span class="arrow" aria-hidden="true">▶</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <p class="credits">
      © {year} {profile.name} · Progress saved
      <span class="blink" aria-hidden="true">▮</span>
    </p>
  </div>
</footer>

<style>
  .save-point {
    margin-top: 24px;
    padding-block: 56px 32px;
    background: var(--bg-2);
    border-top: 4px solid var(--shadow);
    box-shadow: inset 0 4px 0 0 var(--panel-2);
  }
  .sp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .lead { color: var(--ink-dim); max-width: 42ch; }
  .sp-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sp-links a {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 12px 14px;
    background: var(--panel);
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 0 0 2px var(--panel-2);
  }
  .sp-links a:hover { background: var(--gold); color: var(--shadow); }
  .sp-links a:hover .k { color: var(--shadow); }
  .k { font-family: var(--font-display); font-size: var(--fs-pixel-xs); text-transform: uppercase; color: var(--ink-dim); }
  .v { overflow-wrap: anywhere; }
  .arrow { font-size: var(--fs-pixel-sm); }
  .credits {
    margin: 48px 0 0;
    font-family: var(--font-display);
    font-size: var(--fs-pixel-xs);
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .blink { animation: blink 1s steps(1) infinite; color: var(--gold); }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 760px) {
    .sp-grid { grid-template-columns: 1fr; gap: 24px; }
    .sp-links a { grid-template-columns: 80px 1fr auto; }
  }
</style>
